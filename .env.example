NODE_ENV=development
SERVER_PORT=5000
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://cyberlabx_admin:change_me@localhost:27017/cyberlabx?authSource=admin
MONGO_ROOT_USERNAME=cyberlabx_admin
MONGO_ROOT_PASSWORD=change_me
MONGO_DATABASE=cyberlabx
MONGO_PORT=27017
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
# Optional Google OAuth. Configure ALL THREE to enable; secrets stay on the backend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Development: http://localhost:5000/api/auth/google/callback
# Production: https://your-api-domain/api/auth/google/callback
GOOGLE_CALLBACK_URL=
BCRYPT_ROUNDS=12
LAB_NETWORK_PREFIX=cyberlabx-lab
LAB_IMAGE=cyberlabx-kali:latest
TARGET_IMAGE=cyberlabx-target:latest
DOS_ATTACKER_IMAGE=cyberlabx-dos-attacker:latest
DOS_VICTIM_IMAGE=cyberlabx-dos-victim:latest
DOS_CLIENT_IMAGE=cyberlabx-dos-client:latest
REPORT_DIR=./reports
LAB_TTL_MINUTES=45
LAB_MEMORY_MB=512
LAB_CPU_NANOS=500000000
# Docker remains the default; qemu opts in ONLY the Nmap experiment.
LAB_BACKEND=docker
QEMU_BINARY=qemu-system-x86_64
QEMU_IMG_BINARY=qemu-img
# Optional absolute paths; omit to use infrastructure/vm/kali/base/kali.qcow2 and runtime/.
# VM_BASE_IMAGE=C:/path/to/prepared/kali.qcow2
# VM_RUNTIME_DIR=C:/path/to/private/runtime
VM_MEMORY_MB=4096
VM_CPUS=2
VM_HOST_RESERVE_MB=2048
VM_MAX_CONCURRENT=1
VM_NETWORK_MODE=nat
VM_ALLOW_INTERNET=false
SEED_ADMIN_EMAIL=admin@cyberlabx.local
SEED_ADMIN_PASSWORD=change_me
SEED_FACULTY_EMAIL=faculty@cyberlabx.local
SEED_FACULTY_PASSWORD=change_me
SEED_STUDENT_EMAIL=student@cyberlabx.local
SEED_STUDENT_PASSWORD=change_me
